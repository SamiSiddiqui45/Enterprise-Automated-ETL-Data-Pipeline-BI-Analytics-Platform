# SQL Server Connection Configuration
# For local SQL Server Express using Windows Authentication:
DB_SERVER=.\SQLEXPRESS
DB_NAME=AnalyticsDW
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Optional SQL Authentication (leave blank if using Windows Authentication)
DB_USER=
DB_PASSWORD=

# Source Dataset Configuration
SOURCE_CSV_PATH=archive (1)/Sample - Superstore.csv
CSV_ENCODING=cp1252

# Pipeline Runtime & Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log
BATCH_SIZE=1000
